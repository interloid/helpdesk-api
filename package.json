{
  "name": "helpdesk-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "npm run build && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/server.js\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run build && typeorm migration:generate -d dist/database/data-source.js",
    "db:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "db:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "db:seed": "npm run build && node dist/database/seed.js",
    "test": "NODE_ENV=test LOG_LEVEL=silent vitest run"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "overrides": {
    "glob": "^14.0.3"
  }
}
