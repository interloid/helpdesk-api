{
  "compilerOptions": {
    // File layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment (Node 26, native ESM)
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "sourceMap": true,

    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // TypeORM / class-validator (legacy decorators + reflect-metadata)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Emit plain property assignments instead of own-property class fields,
    // so fields don't shadow accessors that decorators define on the prototype.
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,

    // Module hygiene
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
