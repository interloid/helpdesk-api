# Copy to .env for local development. Every variable is validated at boot (src/config/env.ts);
# anything marked "default" can be omitted.

# --- App ---
NODE_ENV=development            # development | production | test
PORT=3000
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent (default info)
CORS_ORIGIN=http://localhost:5173   # comma-separated exact origins; "*" is not allowed
TRUST_PROXY=0                   # reverse-proxy hops in front of the app (0 = exposed directly)

# --- HTTP server ---
# HTTP_REQUEST_TIMEOUT_MS=30000
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000  # keep above the load balancer's idle timeout
# SHUTDOWN_TIMEOUT_MS=10000         # match the orchestrator's termination grace period

# --- Rate limiting (per client IP, per instance) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk-dev
DB_SSL=disable                  # disable | require | verify-full (use verify-full in production)
# DB_SSL_CA=/path/to/ca.pem      # CA bundle for verify-full with a private CA
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000  # 0 disables
# DB_CONNECT_RETRIES=5           # boot-time attempts, exponential backoff from 1s

# --- Health ---
# READINESS_CACHE_MS=1000
